{
	"id": "server_pages",
	"suites": [
		{
			"name": "pure",
			"expected": "10s",
			"triggers": [
				"src/public/pages/{service_worker,service_worker_policy}.mjs",
				"src/public/pages/test/pure/**"
			],
			"run": [
				"deno",
				"run",
				"--allow-scripts",
				"--allow-all",
				"-c",
				"./deno.json",
				"./src/scripts/test/deno/serial.mjs",
				"./src/public/pages/test/pure/"
			]
		},
		{
			"name": "frontend",
			"expected": "4m31s",
			"dependsOn": [
				"server:live"
			],
			"triggers": [
				"src/public/pages/test/frontend/**",
				"src/public/pages/login/**",
				"src/public/pages/base.mjs",
				"src/public/pages/scripts/endpoints/base.mjs",
				"src/public/pages/scripts/components/passwordStrength.mjs",
				"src/public/pages/scripts/components/imageEditor.mjs",
				"src/public/pages/scripts/components/mediaViewer.mjs",
				"src/public/pages/scripts/features/toast.mjs",
				"src/public/pages/scripts/features/notificationSound.mjs",
				"src/public/pages/scripts/i18n/index.mjs",
				"src/public/pages/scripts/i18n/placeholders.mjs",
				"src/public/pages/scripts/test/watch/layout.mjs"
			],
			"subtests": [
				{
					"name": "login",
					"expected": "40s",
					"triggers": [
						"src/public/pages/test/frontend/login.spec.mjs",
						"src/public/pages/test/frontend/fixtures.mjs",
						"src/public/pages/login/**",
						"src/public/pages/scripts/endpoints/base.mjs",
						"src/public/pages/scripts/components/passwordStrength.mjs"
					]
				},
				{
					"name": "toast",
					"expected": "20s",
					"triggers": [
						"src/public/pages/test/frontend/toast.spec.mjs",
						"src/public/pages/test/frontend/fixtures.mjs",
						"src/public/pages/scripts/features/toast.mjs"
					]
				},
				{
					"name": "i18nPlaceholder",
					"expected": "20s",
					"triggers": [
						"src/public/pages/test/frontend/i18nPlaceholder.spec.mjs",
						"src/public/pages/test/frontend/fixtures.mjs",
						"src/public/pages/scripts/i18n/index.mjs",
						"src/public/pages/scripts/i18n/placeholders.mjs"
					]
				},
				{
					"name": "jsonEditorHelper",
					"expected": "15s",
					"triggers": [
						"src/public/pages/test/frontend/jsonEditorHelper.spec.mjs",
						"src/public/pages/test/frontend/fixtures.mjs",
						"src/scripts/test/playwright/json_editor.mjs"
					]
				},
				{
					"name": "pageWatchLayout",
					"expected": "15s",
					"triggers": [
						"src/public/pages/test/frontend/pageWatchLayout.spec.mjs",
						"src/public/pages/test/frontend/fixtures.mjs",
						"src/public/pages/scripts/test/watch/layout.mjs"
					]
				},
				{
					"name": "pageWatchViewport",
					"expected": "20s",
					"triggers": [
						"src/public/pages/test/frontend/pageWatchViewport.spec.mjs",
						"src/public/pages/test/frontend/fixtures.mjs",
						"src/public/pages/scripts/test/watch/viewport.mjs",
						"src/public/pages/scripts/test/watch/flicker.mjs",
						"src/public/pages/scripts/test/watch/mutation_gate.mjs"
					]
				},
				{
					"name": "scrollProgress",
					"expected": "10s",
					"triggers": [
						"src/public/pages/test/frontend/scrollProgress.spec.mjs",
						"src/public/pages/test/frontend/fixtures.mjs",
						"src/public/pages/scripts/features/scrollProgress.mjs"
					]
				},
				{
					"name": "imageEditor",
					"expected": "30s",
					"triggers": [
						"src/public/pages/test/frontend/imageEditor.spec.mjs",
						"src/public/pages/test/frontend/fixtures.mjs",
						"src/public/pages/scripts/components/imageEditor.mjs",
						"src/public/pages/scripts/features/toast.mjs"
					]
				}
			],
			"run": [
				"deno",
				"run",
				"--allow-scripts",
				"--allow-all",
				"-c",
				"./deno.json",
				"./src/public/pages/test/frontend/run.mjs"
			]
		}
	]
}
