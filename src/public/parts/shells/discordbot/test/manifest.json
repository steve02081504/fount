{
	"id": "shells/discordbot",
	"triggerSets": {
		"testFramework": [
			"src/scripts/test/{deno/serial.mjs,node/boot.mjs}"
		],
		"shellPureTests": [
			"src/public/parts/shells/discordbot/test/pure/**",
			"src/public/parts/shells/chat/src/chat/bridge/**"
		],
		"shellIntegrationTests": [
			"src/public/parts/shells/discordbot/test/integration/**",
			"src/public/parts/shells/chat/src/chat/bridge/**",
			"src/public/parts/shells/chat/public/shared/**",
			"src/public/parts/shells/discordbot/src/**",
			"src/public/parts/shells/chat/test/{fixtures/**,harness.mjs}",
			"src/scripts/test/shellLoadProbe.mjs"
		],
		"frontendShared": [
			"src/public/parts/shells/discordbot/public/**",
			"src/public/parts/shells/discordbot/test/frontend/**",
			"src/scripts/test/playwright/**",
			"src/public/pages/scripts/test/**",
			"src/public/pages/scripts/components/jsonEditor.mjs"
		]
	},
	"suites": [
		{
			"name": "pure",
			"trigger": [
				"shellPureTests",
				"testFramework"
			],
			"run": [
				"deno",
				"run",
				"--allow-scripts",
				"--allow-all",
				"-c",
				"./deno.json",
				"./src/scripts/test/deno/serial.mjs",
				"./src/public/parts/shells/discordbot/test/pure/"
			]
		},
		{
			"name": "integration",
			"trigger": [
				"shellIntegrationTests",
				"testFramework"
			],
			"run": [
				"deno",
				"run",
				"--allow-scripts",
				"--allow-all",
				"-c",
				"./deno.json",
				"./src/scripts/test/deno/serial.mjs",
				"./src/public/parts/shells/discordbot/test/integration/"
			]
		},
		{
			"name": "frontend",
			"dependsOn": [
				"server:live"
			],
			"trigger": "frontendShared",
			"subtests": [
				{
					"name": "smoke",
					"triggers": [
						"src/public/parts/shells/discordbot/test/frontend/smoke.spec.mjs",
						"src/public/parts/shells/discordbot/test/frontend/fixtures.mjs",
						"src/public/parts/shells/discordbot/public/index.{html,mjs}"
					]
				},
				{
					"name": "jsonEditor",
					"triggers": [
						"src/public/parts/shells/discordbot/test/frontend/jsonEditor.spec.mjs",
						"src/public/parts/shells/discordbot/test/frontend/fixtures.mjs",
						"src/public/parts/shells/discordbot/public/index.{html,mjs}",
						"src/public/pages/scripts/components/jsonEditor.mjs",
						"src/scripts/test/playwright/json_editor.mjs"
					]
				}
			],
			"run": [
				"deno",
				"run",
				"--allow-scripts",
				"--allow-all",
				"-c",
				"./deno.json",
				"./src/public/parts/shells/discordbot/test/frontend/run.mjs"
			]
		}
	]
}
