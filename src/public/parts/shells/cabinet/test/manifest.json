{
	"id": "shells/cabinet",
	"triggerSets": {
		"testFramework": [
			"src/scripts/test/{deno/serial.mjs,node/boot.mjs}"
		],
		"shellBackend": [
			"src/public/parts/shells/cabinet/src/**",
			"src/public/parts/shells/cabinet/{main.mjs,fount.json,locales.json}"
		],
		"shellPureTests": [
			"src/public/parts/shells/cabinet/test/pure/**"
		],
		"shellIntegrationTests": [
			"src/public/parts/shells/cabinet/test/integration/**"
		],
		"frontendShared": [
			"src/public/parts/shells/cabinet/public/**",
			"src/public/parts/shells/cabinet/test/frontend/{fixtures.mjs,run.mjs,phases.mjs,playwright.config.mjs}",
			"src/public/pages/scripts/test/**"
		]
	},
	"suites": [
		{
			"name": "pure",
			"expected": "41s",
			"trigger": [
				"shellBackend",
				"shellPureTests",
				"testFramework"
			],
			"run": [
				"deno",
				"run",
				"--allow-scripts",
				"--allow-all",
				"-c",
				"./deno.json",
				"./src/scripts/test/deno/serial.mjs",
				"./src/public/parts/shells/cabinet/test/pure/"
			]
		},
		{
			"name": "integration",
			"expected": "43s",
			"dependsOn": [
				"server:live"
			],
			"trigger": [
				"shellBackend",
				"shellIntegrationTests",
				"testFramework"
			],
			"run": [
				"deno",
				"run",
				"--allow-scripts",
				"--allow-all",
				"-c",
				"./deno.json",
				"./src/scripts/test/deno/serial.mjs",
				"./src/public/parts/shells/cabinet/test/integration/"
			]
		},
		{
			"name": "frontend",
			"expected": "3m52s",
			"dependsOn": [
				"server:live"
			],
			"trigger": "frontendShared",
			"subtests": [
				{
					"name": "shortcuts",
					"expected": "16s",
					"triggers": [
						"src/public/parts/shells/cabinet/test/frontend/shortcuts.spec.mjs",
						"src/public/parts/shells/cabinet/test/frontend/fixtures.mjs",
						"src/public/parts/shells/cabinet/public/index.mjs",
						"src/public/parts/shells/cabinet/public/shared/keyboard.mjs",
						"src/public/parts/shells/cabinet/public/src/commands.mjs",
						"src/public/parts/shells/cabinet/public/src/wiring.mjs",
						"src/public/parts/shells/cabinet/public/src/state.mjs",
						"src/public/parts/shells/cabinet/public/src/navigation.mjs",
						"src/public/parts/shells/cabinet/public/src/entryActions.mjs",
						"src/public/parts/shells/cabinet/public/src/entryGrid.mjs",
						"src/public/parts/shells/cabinet/public/shared/commandHistory.mjs",
						"src/public/parts/shells/cabinet/public/src/clipboard.mjs"
					]
				},
				{
					"name": "daisyui",
					"expected": "16s",
					"triggers": [
						"src/public/parts/shells/cabinet/test/frontend/daisyui.spec.mjs",
						"src/public/parts/shells/cabinet/test/frontend/fixtures.mjs",
						"src/public/parts/shells/cabinet/public/index.{html,css}",
						"src/public/parts/shells/cabinet/public/src/contextMenu.mjs",
						"src/public/parts/shells/cabinet/public/src/entryGrid.mjs",
						"src/public/parts/shells/cabinet/public/src/navigation.mjs",
						"src/public/pages/scripts/features/promptDialog.mjs",
						"src/public/pages/scripts/components/positionContextMenu.mjs"
					]
				}
			],
			"run": [
				"deno",
				"run",
				"--allow-scripts",
				"--allow-all",
				"-c",
				"./deno.json",
				"./src/public/parts/shells/cabinet/test/frontend/run.mjs"
			]
		}
	]
}
