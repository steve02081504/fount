{
	"id": "shells/wechatbot",
	"triggerSets": {
		"testFramework": [
			"src/scripts/test/deno/serial.mjs",
			"src/scripts/test/node/boot.mjs"
		],
		"shellPureTests": [
			"src/public/parts/shells/wechatbot/test/pure/**",
			"src/public/parts/shells/chat/src/chat/bridge/**"
		],
		"shellIntegrationTests": [
			"src/public/parts/shells/wechatbot/test/integration/**",
			"src/public/parts/shells/chat/src/chat/bridge/**",
			"src/public/parts/shells/wechatbot/src/**",
			"src/public/parts/shells/chat/test/fixtures/**",
			"src/public/parts/shells/chat/test/harness.mjs"
		],
		"frontendShared": [
			"src/public/parts/shells/wechatbot/public/**",
			"src/public/parts/shells/wechatbot/test/frontend/**",
			"src/scripts/test/playwright/**",
			"src/public/pages/scripts/test/**"
		]
	},
	"suites": [
		{
			"name": "pure",
			"trigger": ["shellPureTests", "testFramework"],
			"run": [
				"deno", "run", "--allow-scripts", "--allow-all", "-c", "./deno.json",
				"./src/scripts/test/deno/serial.mjs",
				"./src/public/parts/shells/wechatbot/test/pure/"
			]
		},
		{
			"name": "integration",
			"trigger": ["shellIntegrationTests", "testFramework"],
			"run": [
				"deno", "run", "--allow-scripts", "--allow-all", "-c", "./deno.json",
				"./src/scripts/test/deno/serial.mjs",
				"./src/public/parts/shells/wechatbot/test/integration/"
			]
		},
		{
			"name": "frontend",
			"dependsOn": ["server:live"],
			"trigger": "frontendShared",
			"subtests": [
				{
					"name": "smoke",
					"triggers": [
						"src/public/parts/shells/wechatbot/test/frontend/smoke.spec.mjs",
						"src/public/parts/shells/wechatbot/test/frontend/fixtures.mjs",
						"src/public/parts/shells/wechatbot/public/index.html",
						"src/public/parts/shells/wechatbot/public/index.mjs"
					]
				}
			],
			"run": ["deno", "run", "--allow-scripts", "--allow-all", "-c", "./deno.json", "./src/public/parts/shells/wechatbot/test/frontend/run.mjs"]
		}
	]
}
