{
	"id": "shells/browserIntegration",
	"triggerSets": {
		"frontendShared": [
			"src/public/parts/shells/browserIntegration/public/**",
			"src/public/parts/shells/browserIntegration/test/frontend/**",
			"src/public/pages/scripts/test/**"
		]
	},
	"suites": [
		{
			"name": "frontend",
			"expected": "1m55s",
			"dependsOn": [
				"server:live"
			],
			"trigger": "frontendShared",
			"subtests": [
				{
					"name": "smoke",
					"expected": "5s",
					"triggers": [
						"src/public/parts/shells/browserIntegration/test/frontend/smoke.spec.mjs",
						"src/public/parts/shells/browserIntegration/test/frontend/fixtures.mjs",
						"src/public/parts/shells/browserIntegration/public/index.{html,mjs}",
						"src/public/parts/shells/browserIntegration/public/templates.mjs"
					]
				}
			],
			"run": [
				"deno",
				"run",
				"--allow-scripts",
				"--allow-all",
				"-c",
				"./deno.json",
				"./src/public/parts/shells/browserIntegration/test/frontend/run.mjs"
			]
		}
	]
}
