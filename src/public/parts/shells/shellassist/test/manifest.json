{
	"id": "shells/shellassist",
	"triggerSets": {
		"testFramework": [
			"src/scripts/test/{deno/serial.mjs,node/boot.mjs}"
		],
		"shellBackend": [
			"src/server/ipc_server/**",
			"src/scripts/markdown_ansi.mjs",
			"src/public/parts/shells/shellassist/src/**",
			"src/public/parts/shells/shellassist/{main.mjs,fount.json,locales.json}",
			"src/scripts/test/shellLoadProbe.mjs"
		],
		"shellIntegrationTests": [
			"src/public/parts/shells/shellassist/test/integration/**"
		]
	},
	"suites": [
		{
			"name": "integration",
			"expected": "57s",
			"trigger": [
				"shellBackend",
				"shellIntegrationTests",
				"testFramework"
			],
			"run": [
				"deno",
				"run",
				"--allow-scripts",
				"--allow-all",
				"-c",
				"./deno.json",
				"./src/scripts/test/deno/serial.mjs",
				"./src/public/parts/shells/shellassist/test/integration/"
			]
		}
	]
}
