{
	"id": "shells/home",
	"triggerSets": {
		"frontendShared": [
			"src/public/parts/shells/home/public/**",
			"src/public/parts/shells/home/test/frontend/**",
			"src/public/pages/scripts/test/**",
			"src/public/pages/scripts/features/template.mjs",
			"src/public/pages/base.mjs",
			"src/scripts/ms.mjs",
			"src/public/pages/invitation-required/**"
		]
	},
	"suites": [
		{
			"name": "pure",
			"expected": "5s",
			"triggers": [
				"src/public/parts/shells/home/public/shared/**",
				"src/public/parts/shells/home/test/pure/**",
				"src/public/parts/shells/chat/public/shared/runUri.mjs"
			],
			"run": [
				"deno",
				"run",
				"--allow-scripts",
				"--allow-all",
				"-c",
				"./deno.json",
				"./src/scripts/test/deno/serial.mjs",
				"./src/public/parts/shells/home/test/pure/"
			]
		},
		{
			"name": "integration",
			"expected": "2m7s",
			"triggers": [
				"src/public/parts/shells/home/src/{invitation,endpoints}.mjs",
				"src/public/parts/shells/home/public/shared/invitationLink.mjs",
				"src/public/parts/shells/home/test/integration/**",
				"src/public/parts/shells/home/test/node_bootstrap.mjs",
				"src/server/invitation.mjs",
				"src/public/parts/shells/chat/src/chat/dm/**",
				"src/public/parts/shells/chat/src/chat/dag/index.mjs",
				"src/public/parts/shells/chat/src/entity/{profile,identity,store}.mjs"
			],
			"run": [
				"deno",
				"run",
				"--allow-scripts",
				"--allow-all",
				"-c",
				"./deno.json",
				"./src/scripts/test/deno/serial.mjs",
				"./src/public/parts/shells/home/test/integration/"
			]
		},
		{
			"name": "frontend",
			"expected": "1m2s",
			"dependsOn": [
				"server:live"
			],
			"trigger": "frontendShared",
			"subtests": [
				{
					"name": "invitation",
					"expected": "45s",
					"triggers": [
						"src/public/pages/invitation-required/**",
						"src/public/parts/shells/home/public/src/endpoints.mjs",
						"src/public/parts/shells/home/test/frontend/invitation.spec.mjs",
						"src/public/parts/shells/home/test/frontend/fixtures.mjs"
					]
				},
				{
					"name": "smoke",
					"expected": "1m15s",
					"triggers": [
						"src/public/parts/shells/home/test/frontend/smoke.spec.mjs",
						"src/public/parts/shells/home/test/frontend/fixtures.mjs",
						"src/public/parts/shells/gist/public/src/title.mjs",
						"src/public/parts/shells/home/public/index.{html,mjs}",
						"src/public/pages/scripts/motion/viewTransition.mjs",
						"src/public/parts/shells/home/public/src/templates.mjs",
						"src/public/pages/scripts/features/template.mjs",
						"src/public/pages/base.mjs",
						"src/public/pages/scripts/i18n/base.mjs",
						"src/scripts/ms.mjs",
						"src/public/parts/shells/home/public/src/{home,inviteFriends}.mjs",
						"src/public/pages/scripts/endpoints/p2p/federation.mjs",
						"src/public/parts/shells/chat/public/shared/runUri.mjs"
					]
				}
			],
			"run": [
				"deno",
				"run",
				"--allow-scripts",
				"--allow-all",
				"-c",
				"./deno.json",
				"./src/public/parts/shells/home/test/frontend/run.mjs"
			]
		}
	]
}
