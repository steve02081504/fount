{
	"id": "shells/telegrambot",
	"triggerSets": {
		"testFramework": [
			"src/scripts/test/{deno/serial.mjs,node/boot.mjs}"
		],
		"shellPureTests": [
			"src/public/parts/shells/telegrambot/test/pure/**",
			"src/public/parts/shells/chat/src/chat/bridge/**"
		],
		"shellIntegrationTests": [
			"src/public/parts/shells/telegrambot/test/integration/**",
			"src/public/parts/shells/chat/src/chat/bridge/**",
			"src/public/parts/shells/chat/public/shared/**",
			"src/public/parts/shells/telegrambot/src/**",
			"src/public/parts/shells/chat/test/{fixtures/**,harness.mjs}",
			"src/scripts/test/shellLoadProbe.mjs"
		],
		"frontendShared": [
			"src/public/parts/shells/telegrambot/public/**",
			"src/public/parts/shells/telegrambot/test/frontend/{fixtures.mjs,run.mjs,phases.mjs,playwright.config.mjs}",
			"src/scripts/test/playwright/**",
			"src/public/pages/scripts/test/**"
		]
	},
	"suites": [
		{
			"name": "pure",
			"expected": "28s",
			"trigger": [
				"shellPureTests",
				"testFramework"
			],
			"run": [
				"deno",
				"run",
				"--allow-scripts",
				"--allow-all",
				"-c",
				"./deno.json",
				"./src/scripts/test/deno/serial.mjs",
				"./src/public/parts/shells/telegrambot/test/pure/"
			]
		},
		{
			"name": "integration",
			"expected": "41s",
			"trigger": [
				"shellIntegrationTests",
				"testFramework"
			],
			"run": [
				"deno",
				"run",
				"--allow-scripts",
				"--allow-all",
				"-c",
				"./deno.json",
				"./src/scripts/test/deno/serial.mjs",
				"./src/public/parts/shells/telegrambot/test/integration/"
			]
		},
		{
			"name": "frontend",
			"expected": "1m5s",
			"dependsOn": [
				"server:live"
			],
			"trigger": "frontendShared",
			"subtests": [
				{
					"name": "smoke",
					"expected": "3s",
					"triggers": [
						"src/public/parts/shells/telegrambot/test/frontend/smoke.spec.mjs",
						"src/public/parts/shells/telegrambot/test/frontend/fixtures.mjs",
						"src/public/parts/shells/telegrambot/public/index.{html,mjs}"
					]
				},
				{
					"name": "jsonEditor",
					"expected": "9s",
					"triggers": [
						"src/public/parts/shells/telegrambot/test/frontend/jsonEditor.spec.mjs",
						"src/public/parts/shells/telegrambot/test/frontend/fixtures.mjs",
						"src/public/parts/shells/telegrambot/public/index.{html,mjs}",
						"src/public/pages/scripts/components/jsonEditor.mjs",
						"src/scripts/test/playwright/json_editor.mjs"
					]
				},
				{
					"name": "urlChar",
					"expected": "10s",
					"triggers": [
						"src/public/parts/shells/telegrambot/test/frontend/urlChar.spec.mjs",
						"src/public/parts/shells/telegrambot/test/frontend/fixtures.mjs",
						"src/public/parts/shells/telegrambot/test/frontend/fixtures/chars/urlChar/**",
						"src/public/parts/shells/telegrambot/public/index.{html,mjs}",
						"src/public/parts/shells/telegrambot/src/{bot.mjs,default_interface/**,endpoints.mjs}",
						"src/public/parts/shells/telegrambot/test/frontend/run.mjs"
					]
				}
			],
			"run": [
				"deno",
				"run",
				"--allow-scripts",
				"--allow-all",
				"-c",
				"./deno.json",
				"./src/public/parts/shells/telegrambot/test/frontend/run.mjs"
			]
		}
	]
}
