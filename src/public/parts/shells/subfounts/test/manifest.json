{
	"id": "shells/subfounts",
	"triggerSets": {
		"testFramework": [
			"src/scripts/test/{deno/serial.mjs,node/boot.mjs}"
		],
		"shellBackend": [
			"src/public/parts/shells/subfounts/src/**",
			"src/public/parts/shells/subfounts/{main.mjs,fount.json,locales.json}",
			"src/scripts/test/shellLoadProbe.mjs"
		],
		"shellIntegrationTests": [
			"src/public/parts/shells/subfounts/test/integration/**"
		]
	},
	"suites": [
		{
			"name": "integration",
			"expected": "7m7s",
			"dependsOn": [
				"server:live"
			],
			"trigger": [
				"shellBackend",
				"shellIntegrationTests",
				"testFramework"
			],
			"run": [
				"deno",
				"run",
				"--allow-scripts",
				"--allow-all",
				"-c",
				"./deno.json",
				"./src/scripts/test/deno/serial.mjs",
				"./src/public/parts/shells/subfounts/test/integration/"
			]
		}
	]
}
