{
	"id": "shells/oauth_handler",
	"triggerSets": {
		"frontendShared": [
			"src/public/parts/shells/oauth_handler/public/**",
			"src/public/parts/shells/oauth_handler/test/frontend/**",
			"src/scripts/test/playwright/**",
			"src/public/pages/scripts/**"
		]
	},
	"suites": [
		{
			"name": "pure",
			"triggers": [
				"src/public/parts/shells/oauth_handler/src/{pkce,portHook,providers,pending}.mjs",
				"src/public/parts/shells/oauth_handler/test/pure/**"
			],
			"run": [
				"deno",
				"test",
				"--allow-scripts",
				"--allow-all",
				"-c",
				"./deno.json",
				"./src/public/parts/shells/oauth_handler/test/pure/"
			]
		},
		{
			"name": "integration",
			"triggers": [
				"src/public/parts/shells/oauth_handler/src/portHook.mjs",
				"src/public/parts/shells/oauth_handler/test/integration/**"
			],
			"run": [
				"deno",
				"run",
				"--allow-scripts",
				"--allow-all",
				"-c",
				"./deno.json",
				"./src/scripts/test/deno/serial.mjs",
				"./src/public/parts/shells/oauth_handler/test/integration/"
			]
		},
		{
			"name": "frontend",
			"dependsOn": [
				"server:live"
			],
			"trigger": "frontendShared",
			"subtests": [
				{
					"name": "smoke",
					"triggers": [
						"src/public/parts/shells/oauth_handler/test/frontend/smoke.spec.mjs",
						"src/public/parts/shells/oauth_handler/public/**",
						"src/public/locales/**"
					]
				}
			],
			"run": [
				"deno",
				"run",
				"--allow-scripts",
				"--allow-all",
				"-c",
				"./deno.json",
				"./src/public/parts/shells/oauth_handler/test/frontend/run.mjs"
			]
		}
	]
}
