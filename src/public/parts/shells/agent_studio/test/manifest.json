{
	"id": "shells/agent_studio",
	"triggerSets": {
		"testFramework": [
			"src/scripts/test/{deno/serial.mjs,node/boot.mjs}"
		],
		"pureCore": [
			"src/public/parts/shells/agent_studio/src/benchmark.mjs",
			"src/public/parts/shells/agent_studio/public/shared/**",
			"src/public/parts/shells/agent_studio/test/pure/**",
			"src/public/parts/shells/chat/src/prompt_struct/**"
		],
		"integrationCore": [
			"src/public/parts/shells/agent_studio/src/**",
			"src/public/parts/shells/agent_studio/test/integration/**",
			"src/public/parts/plugins/sub-agent/state.mjs",
			"src/public/parts/shells/chat/src/chat/session/builtinParts.mjs",
			"src/public/parts/shells/chat/src/prompt_struct/**",
			"src/public/parts/shells/easynew/parts/easychar/template/**",
			"src/public/parts/ImportHandlers/*/Template/**",
			"src/server/parts_loader.mjs",
			"src/server/setting_loader.mjs"
		],
		"frontendShared": [
			"src/public/parts/shells/agent_studio/public/**",
			"src/public/parts/shells/agent_studio/test/frontend/**",
			"src/public/parts/shells/agent_studio/test/node_bootstrap.mjs",
			"src/public/pages/scripts/test/**",
			"src/public/pages/scripts/features/template.mjs"
		]
	},
	"suites": [
		{
			"name": "pure",
			"expected": "8s",
			"trigger": [
				"pureCore",
				"testFramework"
			],
			"run": [
				"deno",
				"run",
				"--allow-scripts",
				"--allow-all",
				"-c",
				"./deno.json",
				"./src/scripts/test/deno/serial.mjs",
				"./src/public/parts/shells/agent_studio/test/pure/"
			]
		},
		{
			"name": "integration",
			"expected": "20s",
			"trigger": [
				"integrationCore",
				"testFramework"
			],
			"run": [
				"deno",
				"run",
				"--allow-scripts",
				"--allow-all",
				"-c",
				"./deno.json",
				"./src/scripts/test/deno/serial.mjs",
				"./src/public/parts/shells/agent_studio/test/integration/"
			]
		},
		{
			"name": "frontend",
			"expected": "1m",
			"dependsOn": [
				"server:live"
			],
			"trigger": "frontendShared",
			"subtests": [
				{
					"name": "smoke",
					"expected": "30s",
					"triggers": [
						"src/public/parts/shells/agent_studio/test/frontend/smoke.spec.mjs",
						"src/public/parts/shells/agent_studio/test/frontend/fixtures.mjs",
						"src/public/parts/shells/agent_studio/public/index.{html,mjs}",
						"src/public/parts/shells/agent_studio/public/src/**",
						"src/public/parts/shells/agent_studio/public/shared/**",
						"src/public/pages/scripts/features/template.mjs"
					]
				}
			],
			"run": [
				"deno",
				"run",
				"--allow-scripts",
				"--allow-all",
				"-c",
				"./deno.json",
				"./src/public/parts/shells/agent_studio/test/frontend/run.mjs"
			]
		}
	]
}
