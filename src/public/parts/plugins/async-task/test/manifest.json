{
	"id": "plugins/async-task",
	"triggerSets": {
		"testFramework": [
			"src/scripts/test/{deno/serial.mjs,node/boot.mjs}"
		],
		"pluginCore": [
			"src/public/parts/plugins/async-task/**",
			"src/public/parts/shells/chat/src/{prompt_struct,reply}/**"
		]
	},
	"suites": [
		{
			"name": "pure",
			"expected": "15s",
			"trigger": [
				"pluginCore",
				"testFramework"
			],
			"run": [
				"deno",
				"run",
				"--allow-scripts",
				"--allow-all",
				"-c",
				"./deno.json",
				"./src/scripts/test/deno/serial.mjs",
				"./src/public/parts/plugins/async-task/test/pure/"
			]
		},
		{
			"name": "integration",
			"expected": "30s",
			"trigger": [
				"pluginCore",
				"testFramework"
			],
			"run": [
				"deno",
				"run",
				"--allow-scripts",
				"--allow-all",
				"-c",
				"./deno.json",
				"./src/scripts/test/deno/serial.mjs",
				"./src/public/parts/plugins/async-task/test/integration/"
			]
		}
	]
}
