{
	"id": "plugins/sub-agent",
	"triggerSets": {
		"testFramework": [
			"src/scripts/test/{deno/serial.mjs,node/boot.mjs}"
		],
		"pluginCore": [
			"src/public/parts/plugins/sub-agent/**",
			"src/public/parts/plugins/async-task/{registry,duration}.mjs",
			"src/public/parts/shells/chat/src/{prompt_struct,reply}/**",
			"src/public/parts/shells/chat/src/chat/lib/visibility.mjs",
			"src/scripts/ms.mjs"
		],
		"integrationDeps": [
			"src/server/parts_loader.mjs",
			"src/public/parts/shells/agent_studio/src/generation_history.mjs"
		]
	},
	"suites": [
		{
			"name": "pure",
			"expected": "15s",
			"trigger": [
				"pluginCore",
				"testFramework"
			],
			"run": [
				"deno",
				"run",
				"--allow-scripts",
				"--allow-all",
				"-c",
				"./deno.json",
				"./src/scripts/test/deno/serial.mjs",
				"./src/public/parts/plugins/sub-agent/test/pure/"
			]
		},
		{
			"name": "integration",
			"expected": "45s",
			"trigger": [
				"pluginCore",
				"integrationDeps",
				"testFramework"
			],
			"run": [
				"deno",
				"run",
				"--allow-scripts",
				"--allow-all",
				"-c",
				"./deno.json",
				"./src/scripts/test/deno/serial.mjs",
				"./src/public/parts/plugins/sub-agent/test/integration/"
			]
		}
	]
}
