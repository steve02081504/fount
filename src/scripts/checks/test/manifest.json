{
	"id": "checks",
	"suites": [
		{
			"name": "html_meta",
			"run": [
				"deno",
				"test",
				"--no-check",
				"--allow-scripts",
				"--allow-all",
				"-c",
				"./deno.json",
				"./src/scripts/checks/test/html_meta.test.mjs"
			],
			"triggers": [
				"src/scripts/checks/html_meta.mjs",
				"src/scripts/checks/walk.mjs",
				"src/scripts/checks/test/html_meta.test.mjs",
				"**/*.html"
			]
		},
		{
			"name": "info",
			"run": [
				"deno",
				"test",
				"--no-check",
				"--allow-scripts",
				"--allow-all",
				"-c",
				"./deno.json",
				"./src/scripts/checks/test/info.test.mjs"
			],
			"triggers": [
				"src/scripts/checks/info.mjs",
				"src/scripts/checks/walk.mjs",
				"src/scripts/checks/test/info.test.mjs",
				"src/public/parts/**/locales.json",
				"src/public/parts/**/achievements_registry.json"
			]
		},
		{
			"name": "i18n_keys",
			"run": [
				"deno",
				"test",
				"--no-check",
				"--allow-scripts",
				"--allow-all",
				"-c",
				"./deno.json",
				"./src/scripts/checks/test/i18n_keys.test.mjs"
			],
			"triggers": [
				"src/scripts/checks/i18n_keys.mjs",
				"src/scripts/checks/test/i18n_keys.test.mjs",
				"src/public/locales/*.json"
			]
		},
		{
			"name": "reshape_i18n_keys",
			"run": [
				"python",
				".esh/commands/reshape_i18n_keys.py",
				"--self-test"
			],
			"triggers": [
				".esh/commands/reshape_i18n_keys.py"
			]
		},
		{
			"name": "agents_md_english",
			"run": [
				"deno",
				"test",
				"--no-check",
				"--allow-scripts",
				"--allow-all",
				"-c",
				"./deno.json",
				"./src/scripts/checks/test/agents_md_english.test.mjs"
			],
			"triggers": [
				"src/scripts/checks/agents_md_english.mjs",
				"src/scripts/checks/test/agents_md_english.test.mjs",
				"**/*.md"
			]
		},
		{
			"name": "jsdoc_english",
			"run": [
				"deno",
				"test",
				"--no-check",
				"--allow-scripts",
				"--allow-all",
				"-c",
				"./deno.json",
				"./src/scripts/checks/test/jsdoc_english.test.mjs"
			],
			"triggers": [
				"src/scripts/checks/jsdoc_english.mjs",
				"src/scripts/checks/test/jsdoc_english.test.mjs",
				"**/*.mjs",
				"**/*.js",
				"**/*.ts"
			]
		}
	]
}
